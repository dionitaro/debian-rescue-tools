# Config SSH pentru mediul rescue.
# root e singurul user din acest mediu -> login direct ca root e ok.
# Se accepta ORICE dintre cheie publica SAU parola (nu ambele obligatoriu).

Port 22
AddressFamily inet
# ListenAddress <IP_ADDR>

PubkeyAuthentication yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile .ssh/authorized_keys

PermitRootLogin yes

UsePAM yes

# Restrictii suplimentare - nu prea au rost intr-un mediu single-user,
# dar nu strica sa ramana
AllowAgentForwarding no
AllowTcpForwarding local
